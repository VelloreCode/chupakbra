# --- Database ---
# Connection string for the Postgres instance (Dokploy-managed Postgres,
# or any other Postgres server). Format:
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@postgres:5432/chupakbra

# Set to "true" only if your Postgres provider requires SSL with a
# self-signed certificate. Leave unset for Dokploy's own Postgres service.
# PGSSL=true

# --- Sessions ---
# Random secret used to sign session cookies. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Cron / internal jobs ---
CRON_SECRET=

# --- Runtime ---
NODE_ENV=production

# Porta HTTP do servidor (API + client). Nesta branch de teste o padrão
# é 5003; defina aqui apenas se precisar de outra porta.
# PORT=5003

# --- Fornecedores: extração automática de preços ---
# Credenciais das contas B2B usadas para ler o preço negociado nos portais.
# NUNCA commitar valores reais aqui — preencher no .env local / Dokploy.

# Identificação enviada aos portais. Mantenha um User-Agent HONESTO:
# a Tambasa fica atrás de Cloudflare e devolve 429 para quem se passa por
# Chrome (o UA não bate com a impressão digital TLS do Node). Identificar-se
# de verdade é o que funciona.
SUPPLIER_USER_AGENT=ChupaKbra-PriceSync/1.0 (+monitoramento de precos B2B)

# Tambasa (atenção: o domínio é .com, o .com.br recusa conexão)
TAMBASA_BASE_URL=https://tambasa.com
# TAMBASA_USER é o e-mail de login do portal.
TAMBASA_USER=
TAMBASA_PASSWORD=
# Espera entre páginas, em ms. Não abaixe sem necessidade.
TAMBASA_DELAY_MS=1500
# Teto de páginas por categoria (protege contra paginação infinita).
TAMBASA_MAX_PAGES=50
TAMBASA_PER_PAGE=100
# axios | playwright — "playwright" ainda não implementado, ver plano.
TAMBASA_ENGINE=axios

# Bartofil (Supabase). A anon key é pública por design, mas fica em env
# porque rotaciona: rotação deve ser mudança de env, não deploy de código.
BARTOFIL_SUPABASE_URL=https://yadsszhyfgiyuqwvaydp.supabase.co
BARTOFIL_SUPABASE_ANON_KEY=
# Informe CNPJ + senha (com ou sem pontuação). O portal autentica por e-mail
# nos bastidores, e o adapter resolve CNPJ -> e-mail sozinho, do mesmo jeito
# que o site faz.
BARTOFIL_CNPJ=
BARTOFIL_PASSWORD=
# Opcional: só se quiser pular o lookup e fixar o e-mail da conta.
BARTOFIL_EMAIL=
BARTOFIL_DELAY_MS=300
BARTOFIL_PAGE_SIZE=100

# Agendamento da sincronização (America/Sao_Paulo).
SUPPLIER_SYNC_ENABLED=true
SUPPLIER_SYNC_CRON=0 7 * * *

# --- Replit SSO (optional, leave unset outside Replit) ---
# Only needed if you want to keep "Sign in with Replit" working.
# If left unset, the app boots normally and only local email/password
# login (/api/auth/login) is available.
# REPLIT_DOMAINS=
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
